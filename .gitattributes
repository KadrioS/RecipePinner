# Detect text files automatically and normalize them to LF in the repository.
# The working copy still uses CRLF on Windows; this just keeps diffs clean.
* text=auto

# Files that Windows tooling expects to be CRLF
*.ps1   text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.slnx  text eol=crlf

# Files that must use Unix line endings
*.sh    text eol=lf

# JSON is handled as normal text (stored as LF).
# LocalizationManager parses these line by line with its own parser, but that
# parser explicitly handles "\r\n", "\r" and "\n", so normalizing line endings
# is safe.
*.json  text

# Binary files: never diffed or normalized
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.dll   binary
*.zip   binary
